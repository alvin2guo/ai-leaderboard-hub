---
import Layout from '../layouts/Layout.astro';
import TimelineLeaderboard from '../components/TimelineLeaderboard.astro';
import SourceCard from '../components/SourceCard.astro';
import { getAllSourcesWithRankings, getAllUniqueModels } from '../utils/data';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const sources = getAllSourcesWithRankings();
const uniqueModels = getAllUniqueModels();

const totalSources = sources.length;
const totalModels = uniqueModels.length;
const autoFetchCount = sources.filter((s) => s.auto_fetch_supported).length;

const categories = [
  { id: 'all', label: '全部榜单' },
  { id: 'comprehensive', label: '综合性能与选型' },
  { id: 'chinese', label: '中文/国内评测' },
  { id: 'specialized', label: '专项评测 (幻觉/检索)' },
];
---

<Layout
  title="AI Leaderboard Hub | 大模型能力评测演变与时间线排行榜"
  description="汇聚主流 AI 大模型能力评测榜单，支持拖动时间轴自由回溯各历史时期模型能力排名，包含 Artificial Analysis、OpenCompass、OpenRouter、SuperCLUE 等。"
>
  <!-- Primary Timeline Interactive Leaderboard Section (Exact Match to User Reference) -->
  <TimelineLeaderboard />

  <!-- Multi-source Explorer & Search Section -->
  <section id="sources-section" class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs font-semibold text-slate-700 dark:text-slate-300 mb-2">
          <span>来源库</span>
          <span class="text-orange-600 dark:text-orange-400">· {totalSources} 个收录源</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
          评测榜单来源库与快照详情
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          点击查看各榜单完整排名快照、具体测试维度（知识/代码/长文本/成本）及官方许可
        </p>
      </div>

      <!-- Quick Search Input -->
      <div class="w-full sm:w-72">
        <div class="relative">
          <input
            type="text"
            id="sources-search-input"
            placeholder="搜索模型、机构或榜单..."
            class="w-full rounded-full border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2 pl-9 text-xs font-medium shadow-xs focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/20 dark:text-white"
          />
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 mt-4 mb-6">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat.id}
          class={`category-tab rounded-full px-4 py-1.5 text-xs font-semibold transition-all cursor-pointer ${
            idx === 0
              ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xs'
              : 'bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Sources Grid -->
    <div id="sources-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {sources.map((source) => (
        <div class="source-card-wrapper" data-category={source.category} data-title={source.name} data-desc={source.description}>
          <SourceCard source={source} />
        </div>
      ))}
    </div>

    <!-- Quick Stats Bar in Capsule Style -->
    <div class="mt-10 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 p-5 flex flex-wrap items-center justify-around gap-4 text-center">
      <div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">{totalSources}</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">收录权威源</div>
      </div>
      <div class="h-8 w-px bg-slate-200 dark:bg-slate-800 hidden sm:block"></div>
      <div>
        <div class="text-2xl font-black text-orange-600 dark:text-orange-400">{autoFetchCount}</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">每日定时同步</div>
      </div>
      <div class="h-8 w-px bg-slate-200 dark:bg-slate-800 hidden sm:block"></div>
      <div>
        <div class="text-2xl font-black text-slate-900 dark:text-white">{totalModels}</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">归一化模型库</div>
      </div>
      <div class="h-8 w-px bg-slate-200 dark:bg-slate-800 hidden sm:block"></div>
      <div>
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">100%</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">原链追溯验证</div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Filter tabs logic
  const tabButtons = document.querySelectorAll('.category-tab');
  const cardWrappers = document.querySelectorAll('.source-card-wrapper');
  const searchInput = document.getElementById('sources-search-input') as HTMLInputElement | null;

  let activeCategory = 'all';
  let searchQuery = '';

  function applyFilters() {
    cardWrappers.forEach((el) => {
      const card = el as HTMLElement;
      const cat = card.getAttribute('data-category') || '';
      const title = (card.getAttribute('data-title') || '').toLowerCase();
      const desc = (card.getAttribute('data-desc') || '').toLowerCase();

      const matchesCat = activeCategory === 'all' || cat === activeCategory;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery);

      if (matchesCat && matchesSearch) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabButtons.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'shadow-xs');
        b.classList.add('bg-slate-100', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-300');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-600', 'dark:bg-slate-800', 'dark:text-slate-300');
      btn.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900', 'shadow-xs');

      activeCategory = btn.getAttribute('data-category') || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    applyFilters();
  });
</script>
