---
import type { SourceWithRanking } from '../utils/types';

interface Props {
  source: SourceWithRanking;
}

const { source } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const categoryMap: Record<string, { label: string; color: string }> = {
  comprehensive: { label: '综合性能', color: 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/40 dark:text-orange-300 dark:border-orange-900' },
  chinese: { label: '中文基准', color: 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-900' },
  specialized: { label: '专项评测', color: 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-900' },
  directory: { label: '资源目录', color: 'bg-slate-50 text-slate-700 border-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:border-slate-800' },
};

const catInfo = categoryMap[source.category] || { label: source.category, color: 'bg-slate-50 text-slate-700 border-slate-200' };
const topModels = source.snapshot ? source.snapshot.models.slice(0, 3) : [];
---

<div
  class="group relative flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-xs transition-all hover:border-orange-400 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-orange-500/60"
  data-category={source.category}
  data-modality={source.modality}
  data-autofetch={source.auto_fetch_supported ? 'true' : 'false'}
>
  <div>
    <!-- Top Tags -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold ${catInfo.color}`}>
          {catInfo.label}
        </span>
        <span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:text-slate-300">
          {source.modality}
        </span>
      </div>

      {source.auto_fetch_supported ? (
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800" title="支持自动定时更新">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          自动更新
        </span>
      ) : (
        <span class="inline-flex items-center rounded-full bg-slate-100 dark:bg-slate-800 px-2.5 py-0.5 text-[10px] font-medium text-slate-500 dark:text-slate-400">
          快照维护
        </span>
      )}
    </div>

    <!-- Title and Description -->
    <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-orange-600 dark:text-white dark:group-hover:text-orange-400 transition-colors">
      <a href={`${baseUrl}/sources/${source.id}`} class="focus:outline-none">
        {source.name}
      </a>
    </h3>
    <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
      {source.description}
    </p>

    <!-- Top Models Capsule Preview if available -->
    {topModels.length > 0 && (
      <div class="mt-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 p-2.5 border border-slate-100 dark:border-slate-800">
        <div class="flex items-center justify-between text-[10px] font-semibold text-slate-500 dark:text-slate-400 mb-1.5 px-1">
          <span>当前榜首快照</span>
          <span>指标分值</span>
        </div>
        <ul class="space-y-1.5">
          {topModels.map((m) => (
            <li class="flex items-center justify-between text-xs">
              <div class="flex items-center gap-1.5 truncate pr-2">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-200 dark:bg-slate-700 text-[10px] font-bold text-slate-700 dark:text-slate-200">
                  {m.rank}
                </span>
                <span class="font-medium text-slate-800 dark:text-slate-200 truncate">
                  {m.model_name}
                </span>
              </div>
              <span class="font-mono font-bold text-slate-900 dark:text-white tabular-nums flex-shrink-0">
                {m.score}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Footer Actions -->
  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
    <span class="text-[11px] text-slate-500 dark:text-slate-400">
      快照: {source.last_checked_at}
    </span>
    <a
      href={`${baseUrl}/sources/${source.id}`}
      class="font-semibold text-orange-600 dark:text-orange-400 hover:text-orange-700 flex items-center gap-1"
    >
      <span>查看完整快照</span>
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
