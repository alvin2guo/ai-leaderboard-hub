{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RankingSnapshot",
  "type": "object",
  "required": ["source_id", "snapshot_date", "source_url", "models"],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "snapshot_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "raw_notes": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "model_name",
          "normalized_model_name",
          "organization",
          "score"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "model_name": {
            "type": "string"
          },
          "normalized_model_name": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "score": {
            "type": ["number", "string"]
          },
          "metrics": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
