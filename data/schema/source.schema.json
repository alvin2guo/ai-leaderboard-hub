{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceList",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "category",
      "modality",
      "url",
      "description",
      "ranking_type",
      "metrics",
      "license_or_terms_url",
      "last_checked_at",
      "update_frequency",
      "auto_fetch_supported"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": ["arena", "comprehensive", "chinese", "specialized", "directory"]
      },
      "modality": {
        "type": "string",
        "enum": ["text", "multimodal", "code", "embedding", "audio", "all"]
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "description": {
        "type": "string"
      },
      "ranking_type": {
        "type": "string",
        "enum": ["elo", "benchmark", "human_eval", "win_rate", "cost_quality", "curated_list"]
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "license_or_terms_url": {
        "type": "string",
        "format": "uri"
      },
      "last_checked_at": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "update_frequency": {
        "type": "string",
        "enum": ["daily", "weekly", "bi-weekly", "monthly", "manual"]
      },
      "auto_fetch_supported": {
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
